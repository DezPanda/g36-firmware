+/* Work out which rectangles of an overlay image have anything in them (alpha above 0):
+ * each row's runs of non-transparent pixels, joined with the identical run in the row
+ * above. More than OGA_OV_MAX_RECTS of them (a busy picture) -> one rectangle for it all. */
+static void oga_overlay_scan(oga_overlay_t *o, const uint32_t *px, int w, int h)
+{
+   typedef struct { int x0, x1, y0; bool used; } run_t;
+   run_t prev[OGA_OV_MAX_RECTS], cur[OGA_OV_MAX_RECTS];
+   int nprev = 0, y, i, j;
+   bool overflow = false;
+
+   o->nrects = 0;
+
+   for (y = 0; y <= h && !overflow; y++)
+   {
+      int ncur = 0;
+
+      if (y < h)
+      {
+         const uint32_t *row = px + (size_t)y * w;
+         int x = 0;
+         while (x < w)
+         {
+            int start;
+            while (x < w && (row[x] >> 24) == 0)
+               x++;
+            if (x >= w)
+               break;
+            start = x;
+            while (x < w && (row[x] >> 24) != 0)
+               x++;
+            if (ncur == OGA_OV_MAX_RECTS)
+            {
+               overflow = true;
+               break;
+            }
+            cur[ncur].x0   = start;
+            cur[ncur].x1   = x;
+            cur[ncur].y0   = y;
+            cur[ncur].used = false;
+            ncur++;
+         }
+      }
+
+      /* runs that continue the previous row's keep its start row; the others are finished */
+      for (i = 0; i < nprev && !overflow; i++)
+      {
+         for (j = 0; j < ncur; j++)
+            if (!cur[j].used && cur[j].x0 == prev[i].x0 && cur[j].x1 == prev[i].x1)
+               break;
+         if (j < ncur)
+         {
+            cur[j].used = true;
+            cur[j].y0   = prev[i].y0;
+         }
+         else if (o->nrects == OGA_OV_MAX_RECTS)
+            overflow = true;
+         else
+         {
+            oga_ov_rect_t *r = &o->rects[o->nrects++];
+            r->x = prev[i].x0;
+            r->y = prev[i].y0;
+            r->w = prev[i].x1 - prev[i].x0;
+            r->h = y - prev[i].y0;
+         }
+      }
+
+      memcpy(prev, cur, sizeof(run_t) * ncur);
+      nprev = ncur;
+   }
+
+   if (overflow)
+   {
+      o->nrects  = 1;
+      o->rects[0].x = 0;
+      o->rects[0].y = 0;
+      o->rects[0].w = w;
+      o->rects[0].h = h;
+   }
+
+   /* a rectangle with no see-through pixel in it can be copied instead of blended */
+   for (i = 0; i < o->nrects; i++)
+   {
+      oga_ov_rect_t *r = &o->rects[i];
+      int xx, yy;
+      r->opaque = true;
+      for (yy = r->y; yy < r->y + r->h && r->opaque; yy++)
+         for (xx = r->x; xx < r->x + r->w; xx++)
+            if ((px[(size_t)yy * w + xx] >> 24) != 0xff)
+            {
+               r->opaque = false;
+               break;
+            }
+   }
+}
+
+static bool oga_overlay_load(void *data, const void *image_data, unsigned num_images)
+{
+   unsigned i;
+   oga_video_t *vid                   = (oga_video_t*)data;
+   const struct texture_image *images = (const struct texture_image*)image_data;
+
+   if (!vid)
+      return false;
+
+   oga_overlay_free(vid);
+
+   vid->overlays = (oga_overlay_t*)calloc(num_images, sizeof(*vid->overlays));
+   if (!vid->overlays)
+      return false;
+   vid->overlay_count = num_images;
+
+   for (i = 0; i < num_images; i++)
+   {
+      oga_overlay_t *o = &vid->overlays[i];
+      int y;
+
+      o->surface = oga_create_surface(vid->fd, images[i].width, images[i].height, OGA_FMT_32);
+      if (!o->surface)
+      {
+         oga_overlay_free(vid);
+         return false;
+      }
+      /* pixels are 0xAARRGGBB, which is how the BGRA surfaces are laid out. The RGA's
+       * blend (0x105) wants the colours already multiplied by alpha, so do that here. */
+      for (y = 0; y < (int)images[i].height; y++)
+      {
+         const uint32_t *in = images[i].pixels + (size_t)y * images[i].width;
+         uint32_t *out      = (uint32_t*)(o->surface->map + (size_t)y * o->surface->pitch);
+         unsigned x;
+         for (x = 0; x < images[i].width; x++)
+         {
+            uint32_t px = in[x];
+            uint32_t a  = px >> 24;
+            if (a == 0xff)
+               out[x] = px;
+            else if (a == 0)
+               out[x] = 0;
+            else
+               out[x] = (a << 24)
+                  | ((((px >> 16) & 0xff) * a / 255) << 16)
+                  | ((((px >> 8) & 0xff) * a / 255) << 8)
+                  | ((px & 0xff) * a / 255);
+         }
+      }
+
+      oga_overlay_scan(o, images[i].pixels, images[i].width, images[i].height);
+      RARCH_LOG("[oga] Overlay image %u: %ux%u, %d rectangle(s) to draw.\n",
+            i, images[i].width, images[i].height, o->nrects);
+
+      o->vx = 0.0f; o->vy = 0.0f; o->vw = 1.0f; o->vh = 1.0f;
+      o->tx = 0.0f; o->ty = 0.0f; o->tw = 1.0f; o->th = 1.0f;
+      o->alpha = 1.0f;
+   }
+   return true;
+}

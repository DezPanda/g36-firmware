+/* a piece of the backdrop: landscape rectangle (x, y, w, h), same mapping as the game and the overlays */
+static void oga_bezel_strip(oga_video_t *vid, oga_surface_t *page, int x, int y, int w, int h)
+{
+   if (x < 0) { w += x; x = 0; }
+   if (y < 0) { h += y; y = 0; }
+   if (x + w > vid->drm_width)  w = vid->drm_width - x;
+   if (y + h > vid->drm_height) h = vid->drm_height - y;
+   if (w < 2 || h < 2)
+      return;
+   oga_blit(vid->bezel, x, y, w, h, page, y, vid->drm_width - x - w, h, w, HAL_TRANSFORM_ROT_270, vid->scale_mode, 0);
 }
 

+/* G36: /tmp/g36-bezel.raw is written by g36menu just before a game starts: "G36B", width, height, 4 spare
+ * bytes, then width*height 0xAARRGGBB pixels. If it's there and as big as the screen it becomes the backdrop
+ * around the game picture (everything the picture doesn't cover) instead of black. */
+static oga_surface_t *oga_bezel_load(oga_video_t *vid)
+{
+   uint32_t head[4];
+   oga_surface_t *surface = NULL;
+   FILE *f = fopen("/tmp/g36-bezel.raw", "rb");
+   int y;
+
+   if (!f)
+      return NULL;
+   if (fread(head, sizeof(head), 1, f) != 1 || head[0] != 0x42363347u
+         || head[1] != (uint32_t)vid->drm_width || head[2] != (uint32_t)vid->drm_height)
+      goto out;
+   if (!(surface = oga_create_surface(vid->fd, vid->drm_width, vid->drm_height, OGA_FMT_32)))
+      goto out;
+   for (y = 0; y < vid->drm_height; y++)
+      if (fread(surface->map + (size_t)y * surface->pitch, 4, vid->drm_width, f) != (size_t)vid->drm_width)
+      {
+         oga_destroy_surface(surface);
+         surface = NULL;
+         break;
+      }
+out:
+   fclose(f);
+   if (surface)
+      RARCH_LOG("[oga] Border backdrop loaded from /tmp/g36-bezel.raw.\n");
+   return surface;
+}

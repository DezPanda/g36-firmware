+/* Draw the overlays on the page (which is the screen turned on its side, like the game). */
+static void oga_overlay_draw(oga_video_t *vid, oga_surface_t *page)
+{
+   unsigned i;
+   int n;
+   const int sw = vid->drm_width;    /* landscape size, as the player sees it */
+   const int sh = vid->drm_height;
+
+   for (i = 0; i < vid->overlay_count; i++)
+   {
+      oga_overlay_t *o = &vid->overlays[i];
+      float bx = 0.0f, by = 0.0f, bw = (float)sw, bh = (float)sh;
+      float dx, dy, dw, dh, iw, ih, fx, fy, tx0, ty0, tx1, ty1;
+      unsigned blend_global;
+
+      if (!o->surface || o->alpha <= 0.0f || o->tw <= 0.0f || o->th <= 0.0f)
+         continue;
+
+      if (!vid->overlay_full)
+      {
+         bx = (float)vid->game_rect.x;
+         by = (float)vid->game_rect.y;
+         bw = (float)vid->game_rect.w;
+         bh = (float)vid->game_rect.h;
+      }
+
+      dx = bx + o->vx * bw;
+      dy = by + o->vy * bh;
+      dw = o->vw * bw;
+      dh = o->vh * bh;
+      iw = (float)o->surface->width;
+      ih = (float)o->surface->height;
+      fx = dw / (o->tw * iw);
+      fy = dh / (o->th * ih);
+      tx0 = o->tx * iw;  tx1 = tx0 + o->tw * iw;
+      ty0 = o->ty * ih;  ty1 = ty0 + o->th * ih;
+      blend_global = (unsigned)(o->alpha * 255.0f + 0.5f);
+      if (blend_global > 255)
+         blend_global = 255;
+
+      for (n = 0; n < o->nrects; n++)
+      {
+         const oga_ov_rect_t *r = &o->rects[n];
+         float cx0 = (float)r->x, cy0 = (float)r->y;
+         float cx1 = (float)(r->x + r->w), cy1 = (float)(r->y + r->h);
+         int lx0, ly0, lx1, ly1;       /* destination, landscape */
+         int sx, sy, sxw, syh;          /* source */
+         unsigned blend;
+
+         /* the part of the rectangle inside the image window being shown */
+         if (cx0 < tx0) cx0 = tx0;
+         if (cy0 < ty0) cy0 = ty0;
+         if (cx1 > tx1) cx1 = tx1;
+         if (cy1 > ty1) cy1 = ty1;
+         if (cx1 <= cx0 || cy1 <= cy0)
+            continue;
+
+         lx0 = (int)(dx + (cx0 - tx0) * fx + 0.0f);
+         ly0 = (int)(dy + (cy0 - ty0) * fy + 0.0f);
+         lx1 = (int)(dx + (cx1 - tx0) * fx + 0.999f);
+         ly1 = (int)(dy + (cy1 - ty0) * fy + 0.999f);
+         /* keep it on the screen */
+         if (lx0 < 0) lx0 = 0;
+         if (ly0 < 0) ly0 = 0;
+         if (lx1 > sw) lx1 = sw;
+         if (ly1 > sh) ly1 = sh;
+         if (lx1 <= lx0 || ly1 <= ly0)
+            continue;
+
+         sx  = (int)cx0;
+         sy  = (int)cy0;
+         sxw = (int)(cx1 + 0.999f) - sx;
+         syh = (int)(cy1 + 0.999f) - sy;
+         if (sx + sxw > (int)o->surface->width)  sxw = (int)o->surface->width - sx;
+         if (sy + syh > (int)o->surface->height) syh = (int)o->surface->height - sy;
+         if (sxw <= 0 || syh <= 0)
+            continue;
+
+         blend = (r->opaque && blend_global == 255) ? 0 : ((blend_global << 16) | 0x105);
+
+         /* landscape (x, y) -> page (y, sw - x), as for the game (rotation 270) */
+         oga_blit(o->surface, sx, sy, sxw, syh,
+               page, ly0, sw - lx1, ly1 - ly0, lx1 - lx0,
+               HAL_TRANSFORM_ROT_270, vid->scale_mode, blend);
+      }
    }
+}
